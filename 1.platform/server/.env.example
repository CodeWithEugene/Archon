# Nebius Token Factory inference (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Token Factory Sandboxes (beta). Project ID comes from the Nebius console.
NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/sandboxes/
NEBIUS_PROJECT_ID=
# Tavily Search API
TAVILY_API_KEY=
# LangSmith tracing (optional). Tracing is on when the key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=archon

# ARCHON behaviour
ARCHON_ENV=development                 # development | production
ARCHON_LLM_BACKEND=nebius              # nebius | fake
ARCHON_SANDBOX_BACKEND=contree         # contree | local (dev only, runs repo code on this machine) | fake
ARCHON_DEMO_TOKEN=                     # required for live missions when set; leave empty for local dev
ARCHON_MAX_MISSION_USD=3.0
ARCHON_MAX_ITERATIONS=5
ARCHON_CANDIDATES_PER_ITERATION=2
ARCHON_COMMAND_TIMEOUT_S=900
ARCHON_TAVILY_TIMEOUT_S=10
ARCHON_DB_PATH=./archon.db
ARCHON_RECORDINGS_DIR=./tests/golden/recordings
ARCHON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ARCHON_ALLOW_LOCAL_REPOS=false         # allow file:// repo URLs; only with the local backend

# Model overrides (development: point ULTRA at Super to save credits)
# ARCHON_ULTRA_MODEL=nvidia/nemotron-3-super-120b-a12b
# ARCHON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# ARCHON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
